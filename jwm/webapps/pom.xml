    <build>
        <plugins>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>deploy-war</id>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                            <echo>Deploying ${project.name} (${project.build.directory}/${project.build.finalName}.war) to http://${domain.url}/manager/text/deploy?path=/${project.name}&amp;update=true</echo>
                                <exec executable="curl">
                                    <arg value="-u" />
                                    <arg value="Admin:ten10Twenty!" />
                                    <arg value="--upload-file" />
                                    <arg value="${project.build.directory}/${project.build.finalName}.war" />
                                    <arg value="http://${domain.url}/manager/text/deploy?path=/${project.name}&amp;update=true" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    
