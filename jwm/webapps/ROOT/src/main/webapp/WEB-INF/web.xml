<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>Professor Jerry RV</display-name>
  <servlet>
    <servlet-name>index</servlet-name>
    <jsp-file>/index.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>about</servlet-name>
    <jsp-file>/WEB-INF/pages/about.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>services</servlet-name>
    <jsp-file>/WEB-INF/pages/services.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>rv-picks</servlet-name>
    <jsp-file>/WEB-INF/pages/rv-picks.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>contact</servlet-name>
    <jsp-file>/WEB-INF/pages/contact.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>privacy</servlet-name>
    <jsp-file>/WEB-INF/pages/privacy.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>code-of-ethics</servlet-name>
    <jsp-file>/WEB-INF/pages/code-of-ethics.jsp</jsp-file>
  </servlet>
  <servlet>
    <servlet-name>advertising</servlet-name>
    <jsp-file>/WEB-INF/pages/advertising.jsp</jsp-file>
  </servlet>
  <servlet-mapping>
    <servlet-name>index</servlet-name>
    <url-pattern>/index.html</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>about</servlet-name>
    <url-pattern>/about.html</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>services</servlet-name>
    <url-pattern>/services.html</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>rv-picks</servlet-name>
    <url-pattern>/rv-picks.html</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>contact</servlet-name>
    <url-pattern>/contact.html</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>privacy</servlet-name>
    <url-pattern>/privacy.html</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>code-of-ethics</servlet-name>
    <url-pattern>/code-of-ethics.html</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>advertising</servlet-name>
    <url-pattern>/advertising.html</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
