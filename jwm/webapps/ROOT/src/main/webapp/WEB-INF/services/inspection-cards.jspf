<% for (RvPrice rv : RV_PRICES) { %>
<article class="offering-card">
  <div class="offering-photo" aria-hidden="true"><img src="<%= rv.image() %>" alt=""></div>
  <div class="offering-body">
    <h2 id="inspect-<%= rv.id() %>"><%= rv.inspectionTitle() %></h2>
    <% if ("large-trailer".equals(rv.id())) { %>
      <div class="offering-preview">

                <strong>View Complete Sample Inspection Report (101 Pages)</strong>

                <p>

                  <a target="_report" class="offering-pdf"
                    href="assets/documents/MalcolmForestRiverRockwood2515sFinal.pdf"
                    aria-label="View sample inspection report (PDF)">

                    <svg width="28" height="32" viewBox="0 0 28 32" aria-hidden="true" focusable="false">

                      <path d="M4 1h12l8 8v22H4z" fill="white" stroke="currentColor" stroke-width="2" />

                      <path d="M16 1v8h8" fill="none" stroke="currentColor" stroke-width="2" />

                      <rect x="0" y="14" width="28" height="13" rx="2" fill="currentColor" />

                      <text x="14" y="24" text-anchor="middle" fill="white" font-family="sans-serif" font-size="9"
                        font-weight="bold">PDF</text>

                    </svg>

                  </a>

                </p>

              </div>
    <% } %>
    <div class="offering-price"><rv:price regular="<%= rv.inspection() %>" discount="<%= GRAND_OPENING_PERCENT %>" /></div>
  </div>
</article>
<% } %>
