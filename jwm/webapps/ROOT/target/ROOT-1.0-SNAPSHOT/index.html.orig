    main section[id], main h3[id], #contact-form {
      scroll-margin-top: 7rem;
    }
    .service-card .service-icon-link {
      display: inline-block;
      align-self: flex-start;
      margin-top: 0;
      text-decoration: none;
    }
    .service-icon-link .icon { display: grid; }
    .about-art-link { display: block; }
  </style>
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="container header-inner">
      <a class="brand" href="index.html" aria-label="Professor Jerry RV home">
