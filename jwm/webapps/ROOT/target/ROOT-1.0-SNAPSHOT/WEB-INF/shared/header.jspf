<header class="site-header<%= homePage ? "" : " site-header-in-flow" %>" data-header>
    <div class="container header-inner<%= homePage ? " header-with-topic-picker" : "" %>">
      <a class="brand" href="index.html" aria-label="Professor Jerry RV home">
        <img src="/assets/images/logo-banner.png" alt="Professor Jerry RV"
          onerror="this.hidden=true; this.nextElementSibling.hidden=false;">
        <span class="brand-fallback" hidden>Professor Jerry RV</span>
      </a>


      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
        <span class="sr-only">Open navigation</span>
        <span></span><span></span><span></span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation" data-nav>
        <a href="index.html#about">About</a>
        <a href="index.html#services">Services</a>
        <a href="index.html#partners">Products &amp; Partners</a>
        <% if (picksPage) { %>
        <a href="rv-picks.html" aria-current="page">RV Picks</a>
        <% } %>
        <a href="index.html#contact">Contact</a>
        <a class="button button-small" href="tel:+15129156461">Call (512) 915-6461</a>
      </nav>
    </div>
  </header>
