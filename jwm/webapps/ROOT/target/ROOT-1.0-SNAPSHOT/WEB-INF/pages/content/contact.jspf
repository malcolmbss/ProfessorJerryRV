<main class="section" id="main">
<div class="container narrow">
      <p class="eyebrow">Professor Jerry RV</p>
      <h1 style="color: var(--navy); font-size: clamp(2.4rem, 6vw, 4.5rem)">
        Contact
      </h1>
      <p class="lead">
        Have a question about your RV? Tell me what you'd like help with.
      </p>

      <form id="contact-form" class="form-card" hidden>
        <p>
          <label for="name">Your name (required)</label><br>
          <input id="name" name="name" autocomplete="name" maxlength="120" required>
        </p>

        <p>
          <label for="email">Your email (required)</label><br>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required>
        </p>

        <fieldset>
          <legend>RV details (optional)</legend>

          <p>
            <label for="manufacturer">Manufacturer (ex: Forest River)</label><br>
            <input id="manufacturer" name="manufacturer" maxlength="100">
          </p>

          <p>
            <label for="series">RV series (ex: Rockwood MiniLite)</label><br>
            <input id="series" name="series" maxlength="100">
          </p>

          <p>
            <label for="model">Model number (ex: 2515S)</label><br>
            <input id="model" name="model" maxlength="50">
          </p>

          <p>
            <label for="year">Model year (ex: 2025)</label><br>
            <input id="year" name="year" inputmode="numeric" pattern="[0-9]{4}" maxlength="4">
          </p>
        </fieldset>

        <p>
          <label for="message">How can I help? (required)</label><br>
          <textarea id="message" name="message" rows="6" maxlength="1500" required></textarea>
        </p>

        <p id="email-help">
          This opens a draft in your email app. Review it there, then click Send.
        </p>
        <button class="button" type="submit" aria-describedby="email-help">
          Prepare email
        </button>
      </form>

      <p>
        You can also email me directly at
        <a href="mailto:info@ProfessorJerry.com">info@ProfessorJerry.com</a>.
      </p>
      <p><a class="button" href="index.html">Return home</a></p>
    </div>
</main>
